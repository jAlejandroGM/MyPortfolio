---
import AstroIcon from "../../icons/logos/AstroIcon.astro";
import Bootstrap from "../../icons/logos/Bootstrap.astro";
import CSS from "../../icons/logos/CSS.astro";
import Figma from "../../icons/logos/Figma.astro";
import Flask from "../../icons/logos/Flask.astro";
import Git from "../../icons/logos/Git.astro";
import HTML from "../../icons/logos/HTML.astro";
import Javascript from "../../icons/logos/Javascript.astro";
import PostgreSQL from "../../icons/logos/PostgreSQL.astro";
import Python from "../../icons/logos/Python.astro";
import React from "../../icons/logos/React.astro";
import Supabase from "../../icons/logos/Supabase.astro";
import Tailwind from "../../icons/logos/Tailwind.astro";
import Typescript from "../../icons/logos/Typescript.astro";

const logos = [
  { component: HTML, name: "HTML" },
  { component: CSS, name: "CSS" },
  { component: Javascript, name: "Javascript" },
  { component: Typescript, name: "TypeScript" },
  { component: React, name: "React" },
  { component: AstroIcon, name: "Astro" },
  { component: Bootstrap, name: "Bootstrap" },
  { component: Tailwind, name: "TailwindCSS" },
  { component: Python, name: "Python" },
  { component: Flask, name: "Flask" },
  { component: Supabase, name: "Supabase" },
  { component: PostgreSQL, name: "PostgreSQL" },
  { component: Git, name: "Git" },
  { component: Figma, name: "Figma" },
];

const { t } = Astro.props;
---

<section class="flex flex-col gap-4 md:gap-8">
  <h2>{t.skills.heading}</h2>
  <div class="flex flex-wrap justify-center gap-6 lg:gap-10">
    {
      logos.map(({ component: Logo, name }) => (
        <div class="flex flex-col justify-center items-center gap-2 basis-1/6 lg:basis-1/10 group">
          <Logo
            class="size-10 md:size-12 group-hover:scale-110 transition-all duration-300 drop-shadow-lg drop-shadow-black/70"
            role="img"
            aria-label={name}
          />
          <span class="text-xs md:text-sm font-medium text-center opacity-70 group-hover:opacity-100 transition-opacity">
            {name}
          </span>
        </div>
      ))
    }
  </div>
</section>
