---
import Email from "../../icons/Email.astro";
import Phone from "../../icons/Phone.astro";
import LocationIcon from "../../icons/LocationIcon.astro";
import LinksMenu from "../ui/LinksMenu.astro";
---

<section class="space-y-4">
  <h2>Contact Me</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-14 lg:gap-20">
    <div class="space-y-4">
      <p>
        Estoy abierto a nuevas oportunidades. Si te interesa colaborar o
        conversar, puedes contactarme aquí:
      </p>
      <ul class="space-y-2" aria-label="Información de contacto">
        <li class="flex gap-2">
          <Phone class="size-6" aria-hidden="true" /><a
            href="tel:+51945472320"
            class="drop-shadow-lg drop-shadow-black/50"
            aria-label="Llamar al número +51 945 472 320">+51 945 472 320</a
          >
        </li>
        <li class="flex gap-2">
          <Email class="size-6" aria-hidden="true" /><a
            href="mailto:j.alejandro.guzman.m@gmail.com"
            class="drop-shadow-lg drop-shadow-black/50"
            aria-label="Enviar correo a j.alejandro.guzman.m@gmail.com"
            >j.alejandro.guzman.m@gmail.com</a
          >
        </li>
        <li class="flex gap-2">
          <LocationIcon class="size-6" aria-hidden="true" /><span
            class="drop-shadow-lg drop-shadow-black/50"
            aria-label="Ubicación Lima, Perú">Lima, Perú</span
          >
        </li>
      </ul>
    </div>
    <div class="flex flex-col items-center gap-4 lg:gap-6">
      <img
        class="size-32 lg:size-42 lg:-mt-12 bg-deep shadow-lg shadow-black/60"
        src="/qrcode.svg"
        alt="Código QR para abrir conversación de WhatsApp"
      />
      <LinksMenu />
    </div>
  </div>
</section>
