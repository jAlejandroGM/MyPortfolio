---
import AboutMe from "../components/sections/AboutMe.astro";
import BeyondTech from "../components/sections/BeyondTech.astro";
import Contact from "../components/sections/Contact.astro";
import Education from "../components/sections/Education.astro";
import Header from "../components/sections/Header.astro";
import FeaturedProjects from "../components/sections/FeaturedProjects.astro";
import Skills from "../components/sections/Skills.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main
    class="w-full max-w-sm min-h-screen p-4 sm:max-w-xl md:max-w-3xl lg:max-w-5xl flex flex-col gap-8 md:gap-16 lg:gap-24"
  >
    <Header />
    <div
      class="grid grid-cols-1 gap-8 md:gap-16 md:grid-cols-2 lg:gap-24 xl:gap-36"
    >
      <AboutMe />
      <Skills />
    </div>
    <FeaturedProjects />
    <Education />
    <BeyondTech />
    <Contact />
  </main>
</Layout>
