---
import { Picture } from "astro:assets";
import myAvatar from "../../assets/MyCartoonAvatar-nobg.png";
---

<Picture
  class="object-cover transition-all duration-300 rounded-full shadow-xl border-10 bg-secondary border-primary size-40 md:size-52 shadow-black/50 max-w-64 hover:scale-105"
  src={myAvatar}
  alt="Alejandro Guzmán"
  aria-label="Avatar de Alejandro Guzmán"
/>
