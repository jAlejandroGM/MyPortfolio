---
const { t } = Astro.props;

const articles = [
  {
    title: t["beyond-tech"].article.esports.title,
    content: t["beyond-tech"].article.esports.content,
  },
  {
    title: t["beyond-tech"].article.pets.title,
    content: t["beyond-tech"].article.pets.content,
  },
  {
    title: t["beyond-tech"].article.english.title,
    content: t["beyond-tech"].article.english.content,
  },
];
---

<section class="space-y-6">
  <h2>{t["beyond-tech"].heading}</h2>
  <div class="space-y-4">
    {
      articles.map((article) => (
        <article class="space-y-2">
          <div class="flex items-center gap-2">
            <h3 class="font-bold text-lg md:text-xl drop-shadow-lg drop-shadow-black/50 ">
              {article.title}
            </h3>
            <span class="h-px flex-1 bg-text hidden lg:block" />
          </div>
          <p class="text-pretty">{article.content}</p>
        </article>
      ))
    }
  </div>
</section>
