---
import Github from "../../icons/Github.astro";
import TechIcons from "./TechIcons.astro";
import CardImage from "./CardImage.astro";
import ProjectStatus from "./ProjectStatus.astro";
import ProjectCategory from "./ProjectCategory.astro";

const { project } = Astro.props;
const { title, subtitle, status, category, stack, repo, link, image } =
  project.data;

const { Content } = await project.render();
---

<article
  class="bg-secondary hover:-translate-y-1 text-light flex flex-col shadow-lg shadow-black/70 rounded-2xl transition-all duration-300 max-w-xs lg:max-w-sm mx-auto min-h-80 md:h-110"
>
  <CardImage image={image} title={title} link={link} />
  <div class="flex flex-col justify-between h-full p-3 md:p-4 md:px-8">
    <div class="flex flex-col gap-2">
      <h4
        class="font-title text-lg md:text-xl drop-shadow-lg drop-shadow-black/70"
      >
        {title}
      </h4>
      <div class="flex gap-2 items-center">
        <ProjectStatus status={status} />
        <ProjectCategory category={category} />
      </div>
      <h6 class="text-sm md:text-base md:hidden font-bold italic">
        {subtitle}
      </h6>
      <div class="text-sm md:text-base hidden md:block">
        <Content />
      </div>
    </div>
    <div class="flex items-center justify-between">
      <TechIcons stack={stack} />
      <a
        href={repo}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Abrir repositorio en GitHub del proyecto ${title}`}
      >
        <Github
          class="size-8 lg:size-11 cursor-pointer hover:text-primary transition-all duration-300 drop-shadow-lg drop-shadow-black/70"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</article>
