---
import AboutMe from "../components/sections/AboutMe.astro";
import BeyondTech from "../components/sections/BeyondTech.astro";
import Contact from "../components/sections/Contact.astro";
import Education from "../components/sections/Education.astro";
import FeaturedProjects from "../components/sections/FeaturedProjects.astro";
import Hero from "../components/sections/Hero.astro";
import Skills from "../components/sections/Skills.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main
    class="w-full max-w-md min-h-screen px-8 py-4 md:px-14 lg:px-18 xl:px-20 sm:max-w-xl md:max-w-3xl lg:max-w-5xl flex flex-col gap-8 md:gap-16 lg:gap-24 bg-bg"
  >
    <Hero />
    <div class="grid grid-cols-1 gap-8 md:gap-14 md:grid-cols-2 lg:gap-20">
      <AboutMe />
      <Skills />
    </div>
    <FeaturedProjects />
    <div class="grid grid-cols-1 gap-8 md:gap-14 md:grid-cols-2 lg:gap-20">
      <Education />
      <BeyondTech />
    </div>
    <Contact />
  </main>
</Layout>
