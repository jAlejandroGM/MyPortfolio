---
import Sun from "../../icons/Sun.astro";
import Moon from "../../icons/Moon.astro";

const { t } = Astro.props;
---

<button
  id="theme-toggle"
  aria-label={t["theme-toggle"].aria}
  class="flex items-center justify-center size-10 bg-secondary border-primary border-2 rounded-full cursor-pointer opacity-70 hover:opacity-100 transition-all duration-300 shadow-lg shadow-black/40"
>
  <Moon />
  <Sun />
</button>

<script>
  import { initThemeToggle } from "../../scripts/theme-toggle";
  initThemeToggle();
</script>
