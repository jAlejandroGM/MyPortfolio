---
import LangBtn from "../ui/LangBtn.astro";
import ThemeBtn from "../ui/ThemeBtn.astro";

const { t } = Astro.props;
---

<nav
  class="flex items-center justify-between w-full max-w-md px-4 py-4 md:px-14 lg:px-18 xl:px-20 sm:max-w-xl md:max-w-3xl lg:max-w-5xl bg-bg"
>
  <span
    class="text-2xl md:text-3xl lg:text-4xl font-bold font-title drop-shadow-lg drop-shadow-black/50"
    >alguzdev</span
  >
  <div class="flex gap-4">
    <LangBtn t={t} />
    <ThemeBtn t={t} />
  </div>
</nav>
