---
import CV from "../../icons/CV.astro";
import Email from "../../icons/Email.astro";
import Github from "../../icons/Github.astro";
import LinkedIn from "../../icons/LinkedIn.astro";
import Whatsapp from "../../icons/Whatsapp.astro";
import LinksBtn from "./LinksBtn.astro";
---

<div
  class="flex flex-col items-center gap-4 text-center md:text-start md:items-start"
>
  <h1 class="text-4xl md:text-5xl lg:text-6xl">Alejandro Guzmán</h1>
  <h3 class="text-xl opacity-70 md:text-2xl lg:text-3xl">
    Desarrollador Web Fullstack
  </h3>
  <nav class="flex gap-4 items-center" aria-label="Redes y contacto">
    <LinksBtn
      href="https://www.linkedin.com/in/josealejandrogm/"
      aria-label="LinkedIn"
    >
      <LinkedIn class="size-full" />
    </LinksBtn>
    <LinksBtn href="https://github.com/jAlejandroGM" aria-label="GitHub">
      <Github class="size-full" />
    </LinksBtn>
    <LinksBtn
      href="mailto:j.alejandro.guzman.m@gmail.com"
      aria-label="Enviar correo electrónico"
    >
      <Email class="size-full" />
    </LinksBtn>
    <LinksBtn href="https://wa.me/51945472320" aria-label="WhatsApp">
      <Whatsapp class="size-full" />
    </LinksBtn>
    <LinksBtn
      href="https://flowcv.com/resume/kfmsppk1lwtj"
      title="Abrir CV en una nueva pestaña"
      aria-label="Ver currículum"
    >
      <CV class="size-full" />
    </LinksBtn>
  </nav>
</div>
