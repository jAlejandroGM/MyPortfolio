---
const { t, lang } = Astro.props;

const label = lang === "es" ? "EN" : "ES";
---

<button
  id="lang-toggle"
  aria-label={t["lang-btn"].aria}
  class="flex items-center justify-center size-10 bg-secondary border-primary border-2 rounded-full cursor-pointer opacity-70 hover:opacity-100 transition-all duration-300 shadow-lg shadow-black/40"
>
  <span class="text-text">{label}</span>
</button>

<script>
  import { initLangToggle } from "../../scripts/lang-toggle";
  initLangToggle();
</script>
