---
import Github from "../../icons/Github.astro";
import ExternalLink from "../../icons/ExternalLink.astro";

const { project } = Astro.props;
const { title, subtitle, type, category, stack, repo, link, image } =
  project.data;

const { Content } = await project.render();
---

<article
  class="bg-secondary hover:-translate-y-1 text-light flex flex-col shadow-lg shadow-black/70 rounded-2xl transition-all duration-300 max-w-xs lg:max-w-sm mx-auto"
>
  <a href={link} class="relative group block rounded-t-xl overflow-hidden">
    <img src={image ?? "https://picsum.photos/400/200"} alt={title} />
    <span
      class="absolute inset-0 flex items-center justify-center bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    >
      <ExternalLink class="size-8" />
    </span>
  </a>

  <div class="flex flex-col gap-4 p-4">
    <h4 class="font-title text-xl drop-shadow-lg drop-shadow-black/70">
      {title}
    </h4>
    <h5>{subtitle}</h5>
    <p>
      <Content />
    </p>
    <a class="ml-auto" href={repo}>
      <Github
        class="size-9 lg:size-11 cursor-pointer hover:opacity-70 transition-all duration-300 drop-shadow-lg drop-shadow-black/70"
      />
    </a>
  </div>
</article>
