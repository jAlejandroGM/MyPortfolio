---
import Header from "../components/sections/Header.astro";
import "../styles/global.css";

const { lang, t } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;500;600&family=Play:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />

    <title>Alejandro Guzmán Portfolio</title>
  </head>
  <body class="flex flex-col items-center bg-neutral-900 text-text">
    <Header t={t} lang={lang} />
    <main>
      <slot />
    </main>
  </body>
</html>
