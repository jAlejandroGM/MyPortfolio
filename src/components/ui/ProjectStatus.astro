---
import Check from "../../icons/Check.astro";
import Wrench from "../../icons/Wrench.astro";
import Pause from "../../icons/Pause.astro";

const { t, status } = Astro.props;
---

{
  (() => {
    const s = String(status ?? "").toLowerCase();
    if (s === "paused") {
      return (
        <span
          title={t["project-status"].paused.title}
          class="inline-block"
          aria-label={t["project-status"].paused.aria}
        >
          <Pause
            class="size-5 md:size-6 text-orange-400 drop-shadow-md drop-shadow-black/70"
            aria-hidden="true"
          />
        </span>
      );
    }
    if (s === "ongoing") {
      return (
        <span
          title={t["project-status"].ongoing.title}
          class="inline-block"
          aria-label={t["project-status"].ongoing.aria}
        >
          <Wrench
            class="size-5 md:size-6 text-yellow-300 drop-shadow-md drop-shadow-black/70"
            aria-hidden="true"
          />
        </span>
      );
    }
    if (s === "completed") {
      return (
        <span
          title={t["project-status"].completed.title}
          class="inline-block"
          aria-label={t["project-status"].completed.aria}
        >
          <Check
            class="size-5 md:size-6 text-green-500 drop-shadow-md drop-shadow-black/70"
            aria-hidden="true"
          />
        </span>
      );
    }
    return null;
  })()
}
